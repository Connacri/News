{
  "hosting": [
    {
      "target": "web",
      "public": "apps/web/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/security-policy",
          "destination": "/security-policy.html"
        },
        {
          "source": "/contact",
          "destination": "/contact.html"
        },
        {
          "source": "/about",
          "destination": "/about.html"
        },
        {
          "source": "/mentions-legales",
          "destination": "/mentions-legales.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|html)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|css|woff2|woff|ttf|json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=31536000, immutable"
            }
          ]
        }
      ]
    },
    {
      "target": "mobile",
      "public": "apps/mobile/build/web",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/security-policy",
          "destination": "/security-policy.html"
        },
        {
          "source": "/contact",
          "destination": "/contact.html"
        },
        {
          "source": "/about",
          "destination": "/about.html"
        },
        {
          "source": "/mentions-legales",
          "destination": "/mentions-legales.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|html)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|css|woff2|woff|ttf|json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=31536000, immutable"
            }
          ]
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}