# Environment Variables
PORT=3000
GEMINI_API_KEY=

# Web app (Vite) - translation provider for the audio podcast
# mymemory = free public MT endpoint, keyless (default)
# gemini   = uses /api/translate (requires the API to be hosted + GEMINI_API_KEY)
# off      = curated scripts only, no translation
VITE_TRANSLATE_PROVIDER=mymemory
