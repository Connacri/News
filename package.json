{
  "name": "news-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo FlutterNews OSINT & Tech Radar : app web React, app mobile Flutter, API Express, CI/CD GitHub Actions et deploiement Firebase Hosting.",
  "type": "module",
  "workspaces": [
    "apps/web",
    "services/api"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @news/api",
    "dev:web": "npm run dev --workspace @news/web",
    "build": "npm run build --workspace @news/web && npm run build --workspace @news/api",
    "build:api": "npm run build --workspace @news/api",
    "start": "npm run start --workspace @news/api",
    "preview": "npm run preview --workspace @news/web",
    "lint": "npm run lint --workspace @news/web",
    "typecheck": "npm run typecheck --workspace @news/web",
    "clean": "npm run clean --workspaces --if-present",
    "firebase:deploy:web": "firebase deploy --only hosting:web",
    "firebase:deploy:mobile": "firebase deploy --only hosting:mobile",
    "firebase:deploy": "firebase deploy --only hosting"
  },
  "engines": {
    "node": ">=20"
  }
}
